<!-- *************** REPORT CARD TEMPLATE *************** -->
<!-- Rendered headless with Handlebars.compile() by grading.rest.router.js and streamed as a        -->
<!-- PDF by shared/services/pdf.service.js. Expected data context:                                  -->
<!--   student: { first_name, last_name, email, student_number }                                    -->
<!--   academic_year: { name }                                                                       -->
<!--   block: { name }                                                                               -->
<!--   block_average, block_status, generated_at                                                     -->
<!--   subjects: [{ name, subject_average, subject_status,                                          -->
<!--               tests: [{ name, total_mark, test_status }] }]                                    -->
<!-- The router resolves every curriculum/entity name and falls back to its id                          -->
<!-- string when the referenced document is missing (e.g. soft-deleted).                                -->

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Academic Report Card - {{student.first_name}} {{student.last_name}}</title>
    <style>
      @page {
        size: A4;
        margin: 16mm;
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #1f2430;
        margin: 0;
        padding: 24px;
        font-size: 14px;
      }
      header {
        border-bottom: 3px solid #2563eb;
        padding-bottom: 12px;
        margin-bottom: 20px;
      }
      h1 {
        margin: 0;
        font-size: 22px;
        color: #2563eb;
      }
      h1 small {
        display: block;
        font-size: 12px;
        color: #6b7280;
        font-weight: 400;
      }
      h2 {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #374151;
        margin: 24px 0 8px;
      }
      section {
        margin-bottom: 20px;
      }
      .profile .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 24px;
      }
      .label {
        color: #6b7280;
        font-size: 12px;
      }
      .summary {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 12px 16px;
      }
      .subject h3 {
        margin: 16px 0 4px;
        font-size: 15px;
      }
      .subject-meta {
        margin: 0 0 4px;
        color: #374151;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
      }
      th,
      td {
        border: 1px solid #d1d5db;
        padding: 6px 10px;
        text-align: left;
        font-size: 13px;
      }
      th {
        background: #f3f4f6;
      }
      .status {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: #e5e7eb;
      }
      footer {
        margin-top: 28px;
        border-top: 1px solid #d1d5db;
        padding-top: 10px;
        font-size: 12px;
        color: #6b7280;
      }
    </style>
  </head>
  <body>
    <!-- *************** HEADER *************** -->
    <header>
      <h1>Campus ERP <small>Official Academic Report Card</small></h1>
    </header>

    <!-- *************** STUDENT PROFILE *************** -->
    <section class='profile'>
      <h2>Student Profile</h2>
      <div class='grid'>
        <div><span class='label'>Name:</span> {{student.first_name}} {{student.last_name}}</div>
        <div><span class='label'>Student Number:</span> {{student.student_number}}</div>
        <div><span class='label'>Email:</span> {{student.email}}</div>
        <div><span class='label'>Academic Year:</span> {{academic_year.name}}</div>
        <div><span class='label'>Block:</span> {{block.name}}</div>
      </div>
    </section>

    <!-- *************** OVERALL STANDING *************** -->
    <section class='summary'>
      <h2>Overall Standing</h2>
      <div>Block Average: <strong>{{block_average}}</strong> <span class='status'>{{block_status}}</span></div>
    </section>

    <!-- *************** CURRICULUM STANDING *************** -->
    <section class='standings'>
      <h2>Curriculum Standing</h2>
      {{#each subjects}}
        <div class='subject'>
          <h3>{{name}}</h3>
          <p class='subject-meta'>Average: <strong>{{subject_average}}</strong> <span class='status'>{{subject_status}}</span></p>
          <table>
            <thead>
              <tr>
                <th>Test</th>
                <th>Score</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {{#each tests}}
                <tr>
                  <td>{{name}}</td>
                  <td>{{total_mark}}</td>
                  <td><span class='status'>{{test_status}}</span></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{/each}}
    </section>

    <!-- *************** FOOTER *************** -->
    <footer>
      <p>Issued on {{generated_at}}. This report card is an official document of the Campus ERP system.</p>
    </footer>
  </body>
</html>